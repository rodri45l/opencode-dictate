[Unit]
Description=opencode-dictate local decision service (Laya)
After=network.target

[Service]
Type=simple
ExecStart=%h/opencode-dictate/scripts/serve-laya.sh
Environment=LAYA_PORT=8090
Environment=LAYA_DEVICE=cuda
Environment=LAYA_MODEL=multilingual
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
