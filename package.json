{
  "name": "opencode-dictate",
  "version": "0.1.0-beta.7",
  "publishConfig": {
    "tag": "beta",
    "access": "public"
  },
  "description": "Hands-free voice conversation mode for opencode: dictate prompts, answer questions/permissions by voice, with an animated status indicator.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodri45l/opencode-dictate.git"
  },
  "bugs": {
    "url": "https://github.com/rodri45l/opencode-dictate/issues"
  },
  "homepage": "https://github.com/rodri45l/opencode-dictate#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "voice",
    "dictation",
    "speech-to-text",
    "stt",
    "whisper",
    "conversation-mode",
    "hands-free"
  ],
  "scripts": {
    "build": "bun run build:tui && bun build ./src/index.tsx --outfile=dist/index.js --target=bun --format=esm --production --external solid-js --external '@opentui/solid' --external '@opencode-ai/plugin' --external 'node:*'",
    "deploy": "mkdir -p \"${OPENCODE_CONFIG:-$HOME/.config/opencode}/tui-plugins/opencode-dictate\" && cp src/*.ts src/*.tsx \"${OPENCODE_CONFIG:-$HOME/.config/opencode}/tui-plugins/opencode-dictate/\"",
    "test": "bun test",
    "samples:record": "bash scripts/record-sample.sh",
    "samples:analyze": "bun scripts/analyze-samples.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "build:tui": "bun scripts/build-tui.mjs"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@opencode-ai/sdk": "^1.18.31",
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/solid": "^0.4.5",
    "solid-js": "^1.9.12"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0"
  },
  "engines": {
    "opencode": ">=1.18.0"
  }
}
